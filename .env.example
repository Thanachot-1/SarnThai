# Supabase Configuration for SarnThai Marketplace
# สมัครใช้งานฟรีที่ https://supabase.com แล้วนำค่า Project URL และ anon public key มาใส่ที่นี่
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# OpenTyphoon AI Configuration (https://opentyphoon.ai/)
VITE_TYPHOON_API_KEY=your-typhoon-api-key-here
VITE_TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
VITE_TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
